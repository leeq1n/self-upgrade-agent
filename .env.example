# === LLM Configuration ===
# Two llama-server instances on AGX Thor (verified working 2026-07-07).
# Port 38000 = Qwen3-VL-30B-A3B-Instruct (main, multimodal)
# Port 38001 = Qwen-AgentWorld-35B-A3B (helper, environment simulation)
#
# For minimax (cloud) production: see the cloud section below.

# Main model
LLM_BASE_URL=http://172.16.121.200:38000/v1
LLM_MODEL=qwen3-vl-30b-a3b
LLM_MODELS=qwen3-vl-30b-a3b
# Timeouts: 30s default is too short for any LLM call.  Set higher
# for both per-request (LLM_TIMEOUT) and whole-call budget
# (LLM_TOTAL_TIMEOUT).  Real run on 2026-07-08 with minimax M2 needed
# >30s per call; with default 30s, every call timed out.
LLM_TIMEOUT=300
LLM_TOTAL_TIMEOUT=1800
LLM_MAX_TOKENS=2048

# Helper: Qwen-AgentWorld (simulate patch effects before harness)
LLM_AGENT_WORLD_URL=http://172.16.121.200:38001/v1
LLM_AGENT_WORLD_MODEL=qwen-agentworld-35b-a3b
LLM_AGENT_WORLD_ENABLED=true

# === Thinking mode defaults (per-call override via API) ===
# Default: thinking ON, with budget.  Per-node strategy in pipeline_lg.py.
LLM_ENABLE_THINKING_DEFAULT=true
LLM_THINKING_BUDGET_DEFAULT=2048

# === Local (default — no key needed, thor is local) ===
ANTHROPIC_BASE_URL=http://172.16.121.200:38000/v1

# === Cloud production (minimax) ===
# IMPORTANT: do NOT commit your real key.  Copy this file to .env
# and edit locally.  .env is in .gitignore.
# To switch: set LLM_BASE_URL + LLM_MODEL + LLM_API_KEY_0 below.
#   LLM_BASE_URL=https://api.minimaxi.com/anthropic
#   LLM_MODEL=abab6.5s-chat
#   LLM_API_KEY_0=<your-key-here>  # set locally, never commit
#
# Or via ANTHROPIC_* (Anthropic SDK):
#   ANTHROPIC_API_KEY=<your-key-here>
#   ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# === Self-upgrade agent ===
SELF_UPGRADE_DATA_DIR=./upgrades
SELF_UPGRADE_AUTO_PROMOTE=false
SELF_UPGRADE_HARNESS_MIN_PASS_RATE=1.0
