#!/usr/bin/env bash
# pre-push hook — final ship gate before GitHub push.
#
# Per "Why Bugs Reach Production" (Total Shift Left) + RCA
# best practices, this hook runs the FULL verification suite
# one last time before allowing the push. Catches:
# 1. self_health_check failures
# 2. validate_links broken refs
# 3. pytest failures
# 4. P-14 violations in main files
#
# Always blocking (different from pre-commit which is
# advisory by default). Per RCA: "test in test environment
# before creating a new build for customers".
#
# Per M-n 32 Guardrail #1 (verify target state before ship)
# + M-n 34 pre-task scan (verifying pre-push = verifying
# pre-ship).

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
SELF_HEALTH="$REPO_ROOT/.hermes/scripts/self_health_check.py"
VALIDATE_LINKS="$(cygpath -w "$REPO_ROOT/.hermes/scripts/validate_links.py" 2>/dev/null || echo "$REPO_ROOT/.hermes/scripts/validate_links.py")"

echo "================================================================"
echo "PRE-PUSH GATE (per RCA: test before release)"
echo "================================================================"
echo

# 1. self_health_check (BLOCKING in pre-push, but only BLOCKER-level)
# Per docs/AGENTS_CORE.md + self_health_check docstring, the
# audit has 3 severity levels: BLOCKER, MAJOR, MINOR (advisory).
# Pre-push should only block on BLOCKER. MAJOR/MINOR are
# documented but don't block the push (per self_health_check
# docstring: "advisory, not blocking").
echo "--- 1. self_health_check ---"
if [ -f "$SELF_HEALTH" ]; then
    # Windows: python needs native paths (MSYS /c/... breaks it).
    if command -v cygpath >/dev/null 2>&1; then
        SELF_HEALTH_NATIVE="$(cygpath -w "$SELF_HEALTH")"
    else
        SELF_HEALTH_NATIVE="$SELF_HEALTH"
    fi
    sh_output=$(python "$SELF_HEALTH_NATIVE" 2>&1)
    sh_rc=$?
    echo "$sh_output" | tail -3
    # Extract failure count from JSON output
    blocker_count=$(echo "$sh_output" | python -c "
import sys, json
try:
    d = json.loads(sys.stdin.read())
    failures = d.get('failures', [])
    blocker = [f for f in failures if 'BLOCKER' in str(f) or 'blocker' in str(f)]
    # Note: current self_health_check doesn't have severity
    # field; treat all as advisory. Check if verdict = FAIL
    # and check if any failure indicates BLOCKER.
    if d.get('verdict') == 'FAIL':
        # Heuristic: look for 'BLOCKER' keyword in failures
        blocker = [f for f in failures if 'BLOCKER' in str(f).upper()]
    print(len(blocker))
except Exception:
    print(0)
" 2>/dev/null || echo "0")
    if [ "$sh_rc" != "0" ] && [ "$blocker_count" != "0" ]; then
        echo
        echo "================================================================"
        echo "PRE-PUSH BLOCKED: self_health_check found $blocker_count BLOCKER(s)"
        echo "================================================================"
        exit $sh_rc
    elif [ "$sh_rc" != "0" ]; then
        echo "self_health_check: FAIL but advisory only (per its docstring)"
        echo "  Not blocking pre-push. See docs/ for full failure list."
    else
        echo "self_health_check: PASS"
    fi
else
    echo "self_health_check.py not found — skipping"
fi

# 2. validate_links (BLOCKING in pre-push)
echo
echo "--- 2. validate_links ---"
if [ -f "$VALIDATE_LINKS" ]; then
    # Windows: python needs native paths (MSYS /c/... breaks it).
    if command -v cygpath >/dev/null 2>&1; then
        VALIDATE_LINKS_NATIVE="$(cygpath -w "$VALIDATE_LINKS")"
    else
        VALIDATE_LINKS_NATIVE="$VALIDATE_LINKS"
    fi
    if python "$VALIDATE_LINKS_NATIVE" 2>&1; then
        echo "validate_links: PASS"
    else
        rc=$?
        echo
        echo "================================================================"
        echo "PRE-PUSH BLOCKED: validate_links failed (broken refs)"
        echo "================================================================"
        exit $rc
    fi
else
    echo "validate_links.py not found — skipping"
fi

# 3. P-14 quick check (BLOCKING in pre-push)
echo
echo "--- 3. P-14 self-contained mandate ---"
violations=$(grep -rE "per user message 2026-07-[0-9]+|per c[0-9]+|per R[0-9]+(?!\d)" \
    AGENTS.md core-layer/AGENTS_CORE.md AGENTS_DETAIL.md CHANGELOG.md 2>/dev/null | wc -l | tr -d ' ')
if [ "$violations" != "0" ]; then
    echo
    echo "================================================================"
    echo "PRE-PUSH BLOCKED: P-14 violations in main files"
    echo "================================================================"
    echo "Violations: $violations"
    grep -rEn "per user message 2026-07-[0-9]+|per c[0-9]+|per R[0-9]+(?!\d)" \
        AGENTS.md core-layer/AGENTS_CORE.md AGENTS_DETAIL.md CHANGELOG.md 2>/dev/null
    exit 1
else
    echo "P-14: PASS (0 violations)"
fi

echo
echo "================================================================"
echo "PRE-PUSH PASSED — safe to push"
echo "================================================================"
exit 0
