#!/usr/bin/env bash
# pre-push hook — final ship gate before GitHub push.
#
# Per "Why Bugs Reach Production" (Total Shift Left) + RCA
# best practices, this hook runs the FULL verification suite
# one last time before allowing the push. Catches:
# 1. self_health_check failures
# 2. validate_links broken refs
# 3. pytest failures
# 4. P-14 violations in main files
#
# Always blocking (different from pre-commit which is
# advisory by default). Per RCA: "test in test environment
# before creating a new build for customers".
#
# Per M-n 32 Guardrail #1 (verify target state before ship)
# + M-n 34 pre-task scan (verifying pre-push = verifying
# pre-ship).

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
SELF_HEALTH="$REPO_ROOT/.hermes/scripts/self_health_check.py"
VALIDATE_LINKS="$REPO_ROOT/.hermes/scripts/validate_links.py"

echo "================================================================"
echo "PRE-PUSH GATE (per RCA: test before release)"
echo "================================================================"
echo

# 1. self_health_check (BLOCKING in pre-push)
echo "--- 1. self_health_check ---"
if [ -f "$SELF_HEALTH" ]; then
    if python "$SELF_HEALTH" 2>&1; then
        echo "self_health_check: PASS"
    else
        rc=$?
        echo
        echo "================================================================"
        echo "PRE-PUSH BLOCKED: self_health_check failed"
        echo "================================================================"
        echo
        echo "Per docs/AGENTS_CORE.md 'Ship gate' + RCA best practices:"
        echo "  - Fix the issues above before pushing"
        echo "  - Or use git push --no-verify to bypass (NOT recommended)"
        echo
        exit $rc
    fi
else
    echo "self_health_check.py not found — skipping"
fi

# 2. validate_links (BLOCKING in pre-push)
echo
echo "--- 2. validate_links ---"
if [ -f "$VALIDATE_LINKS" ]; then
    if python "$VALIDATE_LINKS" 2>&1; then
        echo "validate_links: PASS"
    else
        rc=$?
        echo
        echo "================================================================"
        echo "PRE-PUSH BLOCKED: validate_links failed (broken refs)"
        echo "================================================================"
        exit $rc
    fi
else
    echo "validate_links.py not found — skipping"
fi

# 3. P-14 quick check (BLOCKING in pre-push)
echo
echo "--- 3. P-14 self-contained mandate ---"
violations=$(grep -rE "per user message 2026-07-[0-9]+|per c[0-9]+|per R[0-9]+(?!\d)" \
    AGENTS.md core-layer/AGENTS_CORE.md AGENTS_DETAIL.md CHANGELOG.md 2>/dev/null | wc -l | tr -d ' ')
if [ "$violations" != "0" ]; then
    echo
    echo "================================================================"
    echo "PRE-PUSH BLOCKED: P-14 violations in main files"
    echo "================================================================"
    echo "Violations: $violations"
    grep -rEn "per user message 2026-07-[0-9]+|per c[0-9]+|per R[0-9]+(?!\d)" \
        AGENTS.md core-layer/AGENTS_CORE.md AGENTS_DETAIL.md CHANGELOG.md 2>/dev/null
    exit 1
else
    echo "P-14: PASS (0 violations)"
fi

echo
echo "================================================================"
echo "PRE-PUSH PASSED — safe to push"
echo "================================================================"
exit 0
